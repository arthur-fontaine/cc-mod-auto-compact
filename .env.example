# Copy to .env and fill in. Scripts under training/ read it; variables already set in the
# environment win. Never commit .env.

# Teacher: Baseten Mammoth through the System One API.
BASETEN_API_KEY=
DECISION_MODEL=
# DECISION_ENDPOINT=https://inference.baseten.co/v1/systemone
# Billed USD per million input tokens once the free week is over (unknown until then).
# DECISION_PRICE_PER_MTOK=

# Abort any model-calling run whose billed estimate is above this (USD). Required.
MAX_SPEND_USD=

# Summaries: Haiku through the Claude Agent SDK and your Claude Code login.
# SUMMARIZER_MODEL=claude-haiku-5-5
# SUMMARIZER_EFFORT=low
# SUMMARIZER_CONCURRENCY=8
# 1 lets the SDK use ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN (API billing); unset strips them.
# SUMMARIZER_USE_API=

# Optional: higher Hugging Face rate limits for pipeline/fetch.py.
# HF_TOKEN=

# Read by the mod from the environment Claude Code runs in (never from this file):
# SPISEV_API_KEY=          key for a cloud System One provider
# SPISEV_MIN_CONFIDENCE=0.85
